# Local development. The API runs on Cloudflare Workers: `npm run dev` in the
# API repo's worker/ folder serves it with `wrangler dev` on :8787.
# It only answers browsers whose origin is in its ALLOWED_ORIGINS, so for local
# work put  ALLOWED_ORIGINS=http://localhost:3002  in worker/.dev.vars.
NEXT_PUBLIC_API_URL=http://localhost:8787/api/v1
